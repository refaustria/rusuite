{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rusuite Write",
  "version": "3.1415.0",
  "identifier": "dev.rusuite.write",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rusuite Write",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "windows": { "wix": { "version": "3.14.15.0" } },
    "android": { "minSdkVersion": 26 },
    "iOS": { "minimumSystemVersion": "15.0", "developmentTeam": "PM7LTV7M72" },
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
