    </w:r>
   </w:fldSimple>
   <w:r>
    <w:t>: A second picture</w:t>
   </w:r>
  </w:p>
  <w:p>
   <w:pPr>
    <w:pStyle w:val="Caption"/>
    <w:jc w:val="left"/>
   </w:pPr>
   <w:r>
    <w:t xml:space="preserve">Table </w:t>
   </w:r>
   <w:fldSimple w:instr=" SEQ Table \* ARABIC ">
    <w:r>
     <w:t>1</w:t>
    </w:r>
   </w:fldSimple>
   <w:r>
    <w:t>: Some numbers</w:t>
   </w:r>
  </w:p>
  <w:p>
   <w:pPr>
    <w:sectPr>
     <w:pgSz w:w="11906" w:h="16838"/>
     <w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="0" w:footer="0" w:gutter="0"/>
     <w:pgNumType w:fmt="decimal"/>
    </w:sectPr>
   </w:pPr>
  </w:p>
  <w:p>
   <w:pPr>
    <w:pStyle w:val="Normal"/>
    <w:spacing w:before="0" w:after="120"/>
    <w:jc w:val="left"/>
   </w:pPr>
   <w:r>
    <w:t>The quick brown fox jumps over the lazy dog. Reference documents should be small, boring and precise. Every supported feature appears in at least one file.</w:t>
   </w:r>
  </w:p>
  <w:p>
   <w:pPr>
    <w:pStyle w:val="Normal"/>
    <w:jc w:val="left"/>
   </w:pPr>
   <w:r>
    <w:br w:type="column"/>
   </w:r>
   <w:r>
    <w:t>Reference documents should be small, boring and precise. Every supported feature appears in at least one file.</w:t>
   </w:r>
  </w:p>
  <w:p>
   <w:pPr>
    <w:sectPr>
     <w:type w:val="continuous"/>
     <w:pgSz w:w="11906" w:h="16838"/>
     <w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="0" w:footer="0" w:gutter="0"/>
     <w:cols w:space="284" w:num="2"/>
    </w:sectPr>
   </w:pPr>
  </w:p>
  <w:p>
   <w:pPr>
    <w:pStyle w:val="Normal"/>
    <w:spacing w:before="0" w:after="120"/>
    <w:jc w:val="left"/>
   </w:pPr>
   <w:r>
    <w:t>Every supported feature appears in at least one file. Roundtrip means nothing is lost between open and save. Short sentences keep the generated files tiny. The quick brown fox jumps over the lazy dog.</w:t>
   </w:r>
  </w:p>
  <w:p>
   <w:pPr>
    <w:sectPr>
     <w:type w:val="continuous"/>
     <w:pgSz w:w="11906" w:h="16838"/>
     <w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="0" w:footer="0" w:gutter="0"/>
     <w:cols w:space="226" w:num="3" w:sep="1"/>
    </w:sectPr>
   </w:pPr>
  </w:p>
  <w:p>
   <w:pPr>
    <w:pStyle w:val="Normal"/>
    <w:spacing w:before="0" w:after="120"/>
    <w:jc w:val="left"/>
   </w:pPr>
   <w:bookmarkStart w:id="1" w:name="summary"/>
   <w:r>
    <w:t>Summary paragraph</w:t>
   </w:r>
   <w:bookmarkEnd w:id="1"/>
   <w:r>
    <w:t>.</w:t>
   </w:r>
  </w:p>
  <w:sectPr>
   <w:type w:val="continuous"/>
   <w:pgSz w:w="11906" w:h="16838"/>
   <w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="0" w:footer="0" w:gutter="0"/>
