    </p:nvSpPr>
    <p:spPr>
     <a:xfrm>
      <a:off x="838200" y="365125"/>
      <a:ext cx="10515600" cy="1325563"/>
     </a:xfrm>
     <a:prstGeom prst="rect">
      <a:avLst/>
     </a:prstGeom>
    </p:spPr>
    <p:txBody>
     <a:bodyPr wrap="square" lIns="91440" tIns="45720" rIns="91440" bIns="45720" rtlCol="0" anchor="ctr">
      <a:normAutofit/>
     </a:bodyPr>
     <a:lstStyle>
      <a:lvl1pPr algn="l">
       <a:defRPr sz="4400">
        <a:latin typeface="+mj-lt"/>
       </a:defRPr>
      </a:lvl1pPr>
     </a:lstStyle>
     <a:p>
      <a:r>
